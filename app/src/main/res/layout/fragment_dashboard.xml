<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDriveLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:backgroundTint="#388E3C"
                android:text="▶ BAŞLAT"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnShareLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#1976D2"
                android:enabled="false"
                android:text="📤 PAYLAŞ"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnDtcHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:backgroundTint="#7B1FA2"
                android:text="📋 GEÇMİŞ"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnReadVin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:backgroundTint="#00796B"
                android:text="🚗 VIN"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLogStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvShiftIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#D32F2F"
            android:padding="12dp"
            android:text="2. VİTESE AT!"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.github.anastr.speedviewlib.SpeedView
            android:id="@+id/gaugeRpm"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            app:sv_maxSpeed="8000"
            app:sv_minSpeed="0"
            app:sv_speedTextFormat="INTEGER"
            app:sv_textColor="#FFFFFF"
            app:sv_unit="RPM"
            app:sv_unitTextColor="#FFFFFF"
            app:sv_withTremble="false" />

        <com.github.anastr.speedviewlib.SpeedView
            android:id="@+id/gaugeSpeed"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            app:sv_centerCircleColor="#1976D2"
            app:sv_maxSpeed="220"
            app:sv_textColor="#FFFFFF"
            app:sv_unit="km/h"
            app:sv_unitTextColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                app:cardBackgroundColor="#1B5E20"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔋 AKÜ"
                        android:textColor="#A5D6A7"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvBatteryVoltage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- V"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                app:cardBackgroundColor="#0D47A1"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⛽ ANLIK YAKIT"
                        android:textColor="#90CAF9"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvInstantFuel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvInstantFuelUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="L/100km"
                        android:textColor="#90CAF9"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1B3A1B"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⛽ DEPO TAKİBİ"
                        android:textColor="#A5D6A7"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTankInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- L / 50 L"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbTank"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#4CAF50" />

                <TextView
                    android:id="@+id/tvTankRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tahmini menzil: --"
                    android:textColor="#A5D6A7"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRefillFull"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="#388E3C"
                        android:text="🟢 FULL DEPO"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnAddFuel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#1976D2"
                        android:text="➕ KISMİ"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📈 Son 60 saniye"
                    android:textColor="#BDBDBD"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="RPM"
                    android:textColor="#FFCA28"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.example.nsobd2.ui.widgets.MiniLineChartView
                    android:id="@+id/chartRpm"
                    android:layout_width="match_parent"
                    android:layout_height="60dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="HIZ (km/h)"
                    android:textColor="#4FC3F7"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.example.nsobd2.ui.widgets.MiniLineChartView
                    android:id="@+id/chartSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="60dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#333333"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Depo Yakıt Seviyesi:" android:textColor="#4CAF50" android:textStyle="bold" />
                    <TextView android:id="@+id/tvFuelLevel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- %" android:textColor="#4CAF50" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="#555555" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Su Sıcaklığı (Hararet):" android:textColor="#FFFFFF" />
                        <TextView android:id="@+id/tvTempDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- °C" android:textColor="#FF9800" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="İdeal: 85°C - 105°C (110 üstü tehlike)" android:textColor="#9E9E9E" android:textSize="12sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="#555555" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Hesaplanan Motor Yükü:" android:textColor="#FFFFFF" />
                        <TextView android:id="@+id/tvEngineLoad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- %" android:textColor="#FFFFFF" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="İdeal: Rölantide %15 - %30" android:textColor="#9E9E9E" android:textSize="12sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="#555555" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Manifold Basıncı (MAP):" android:textColor="#FFFFFF" />
                        <TextView android:id="@+id/tvMap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- kPa" android:textColor="#FFFFFF" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="İdeal: Rölantide 25 - 40 kPa" android:textColor="#9E9E9E" android:textSize="12sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="#555555" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Emilen Hava Sıcaklığı (IAT):" android:textColor="#FFFFFF" />
                        <TextView android:id="@+id/tvIat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- °C" android:textColor="#FFFFFF" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="İdeal: Dış hava sıcaklığı + 10°C/15°C" android:textColor="#9E9E9E" android:textSize="12sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="#555555" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Gaz Kelebeği Açıklığı (TPS):" android:textColor="#FFFFFF" />
                        <TextView android:id="@+id/tvTps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- %" android:textColor="#FFFFFF" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="İdeal: Rölantide %0 - %12 arası" android:textColor="#9E9E9E" android:textSize="12sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="#555555" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ateşleme Avansı:" android:textColor="#FFFFFF" />
                        <TextView android:id="@+id/tvAvans" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- °" android:textColor="#FFFFFF" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="İdeal: Rölantide 5° - 15° arası" android:textColor="#9E9E9E" android:textSize="12sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="#555555" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kısa Vade Yakıt Trim (STFT):" android:textColor="#FFFFFF" />
                        <TextView android:id="@+id/tvStft" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- %" android:textColor="#03A9F4" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="İdeal: %-5.0 ile %+5.0 arası (Sıfıra yakın)" android:textColor="#9E9E9E" android:textSize="12sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="#555555" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Uzun Vade Yakıt Trim (LTFT):" android:textColor="#FFFFFF" />
                        <TextView android:id="@+id/tvLtft" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- %" android:textColor="#03A9F4" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="İdeal: %-5.0 ile %+5.0 arası" android:textColor="#9E9E9E" android:textSize="12sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="#555555" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Oksijen Sensörü (Lambda 1):" android:textColor="#FFFFFF" />
                        <TextView android:id="@+id/tvO2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- V" android:textColor="#FFFFFF" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="İdeal: Isındıktan sonra 0.1V - 0.9V arası dalgalanır" android:textColor="#9E9E9E" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>