<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnReadDtc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="KODLARI OKU"
                android:backgroundTint="#FF9800" />

            <Button
                android:id="@+id/btnClearDtc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="ARIZAYI SİL"
                android:backgroundTint="#F44336" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="* DİKKAT: Arıza silmek için Kontağı Açın ama Motoru ÇALIŞTIRMAYIN!"
            android:textColor="#FFEB3B"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HAZIRLIK MONİTÖRLERİ (READINESS)" android:textColor="#9E9E9E" android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <TextView
            android:id="@+id/tvReadiness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#333333"
            android:padding="12dp"
            android:text="Bekleniyor..."
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AKTİF ARIZA KODLARI" android:textColor="#F44336" android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <TextView
            android:id="@+id/tvActiveDtc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#333333"
            android:padding="12dp"
            android:text="Bekleniyor..."
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BEKLEYEN ARIZALAR (PENDING)" android:textColor="#FF9800" android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <TextView
            android:id="@+id/tvPendingDtc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#333333"
            android:padding="12dp"
            android:text="Bekleniyor..."
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>