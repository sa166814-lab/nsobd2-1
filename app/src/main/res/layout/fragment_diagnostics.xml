<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ŞASİ NUMARASI -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ŞASİ NUMARASI (VIN)"
            android:textColor="#9E9E9E"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvVin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#333333"
            android:padding="12dp"
            android:text="Henüz okunmadı"
            android:textColor="#FFFFFF"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnReadVin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="ŞASİ OKU"
                android:textSize="12sp"
                android:backgroundTint="#607D8B" />

            <Button
                android:id="@+id/btnCopyVin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="KOPYALA"
                android:textSize="12sp"
                android:backgroundTint="#607D8B" />
        </LinearLayout>

        <!-- OKU / SİL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnReadDtc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="KODLARI OKU"
                android:backgroundTint="#FF9800" />

            <Button
                android:id="@+id/btnClearDtc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="ARIZAYI SİL"
                android:backgroundTint="#F44336" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="* Arıza silmek için kontağı aç ama motoru ÇALIŞTIRMA. Silinen kodlar geçmişe otomatik kaydedilir."
            android:textColor="#FFEB3B"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- DURUM -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEYİN DURUMU"
            android:textColor="#9E9E9E"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvReadiness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#333333"
            android:padding="12dp"
            android:text="Bekleniyor..."
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- AKTİF -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AKTİF ARIZA KODLARI"
            android:textColor="#F44336"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvActiveDtc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#333333"
            android:padding="12dp"
            android:text="Bekleniyor..."
            android:textColor="#FFFFFF"
            android:textIsSelectable="true"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- BEKLEYEN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEKLEYEN ARIZALAR (PENDING)"
            android:textColor="#FF9800"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvPendingDtc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#333333"
            android:padding="12dp"
            android:text="Bekleniyor..."
            android:textColor="#FFFFFF"
            android:textIsSelectable="true"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <!-- HAM CEVAP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HAM ECU CEVABI (doğrulama için)"
            android:textColor="#4CAF50"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvRawResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111111"
            android:padding="12dp"
            android:text="-"
            android:textColor="#7EE787"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- GEÇMİŞ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ARIZA GEÇMİŞİ"
            android:textColor="#03A9F4"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#333333"
            android:padding="12dp"
            android:text="Henüz kayıt yok."
            android:textColor="#E0E0E0"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnShareHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="GEÇMİŞİ PAYLAŞ"
                android:textSize="11sp"
                android:backgroundTint="#03A9F4" />

            <Button
                android:id="@+id/btnClearHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="GEÇMİŞİ SİL"
                android:textSize="11sp"
                android:backgroundTint="#757575" />
        </LinearLayout>

        <Button
            android:id="@+id/btnReports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📄 KAYITLI RAPORLAR"
            android:backgroundTint="#8BC34A"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>