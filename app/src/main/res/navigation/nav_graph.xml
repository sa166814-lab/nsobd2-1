<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_connection">

    <fragment
        android:id="@+id/navigation_connection"
        android:name="com.example.nsobd2.ui.connection.ConnectionFragment"
        android:label="Bağlantı"
        tools:layout="@layout/fragment_connection" />

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.nsobd2.ui.dashboard.DashboardFragment"
        android:label="Kadranlar"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_diagnostics"
        android:name="com.example.nsobd2.ui.diagnostics.DiagnosticsFragment"
        android:label="Arıza"
        tools:layout="@layout/fragment_diagnostics" />

    <fragment
        android:id="@+id/navigation_inspection"
        android:name="com.example.nsobd2.ui.inspection.InspectionFragment"
        android:label="TÜVTÜRK Muayene"
        tools:layout="@layout/fragment_inspection" />

    <fragment
        android:id="@+id/navigation_tests"
        android:name="com.example.nsobd2.ui.tests.TestsFragment"
        android:label="Canlı Testler"
        tools:layout="@layout/fragment_tests" />



</navigation>